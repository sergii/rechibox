#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

REV="dd5caaec3d5d50ad7fc0324da238119c6b7c3707"
DEST="$ROOT/.experiments/appllama-skills"

if ! command -v git >/dev/null 2>&1; then
  echo "Missing required command: git" >&2
  exit 1
fi

rm -rf "$DEST"
mkdir -p "$(dirname "$DEST")"

git clone --quiet https://github.com/Appllama/appllama-skills.git "$DEST"
git -C "$DEST" checkout --quiet "$REV"

echo "Prepared pinned AppLlama skills for task-scoped evaluation."
echo "Revision: $REV"
echo
echo "Read only when the task explicitly calls for the experiment:"
echo "  $DEST/skills/appllama-usage/SKILL.md"
echo "  $DEST/skills/appllama-app-design-skill/SKILL.md"
echo
echo "These skills are intentionally NOT installed into an agent auto-discovery directory."
echo "Rechibox AGENTS.md and the pinned Mobile Engineering Playbook remain authoritative."
echo "The appllama-usage skill requires the paid AppLlama MCP for its full research workflow."
