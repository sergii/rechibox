#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

node <<'NODE'
const fs = require('fs');
const app = JSON.parse(fs.readFileSync('app.json', 'utf8')).expo ?? {};
const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8'));
const eas = JSON.parse(fs.readFileSync('eas.json', 'utf8'));

const checks = [
  ['expo-updates dependency', Boolean(pkg.dependencies?.['expo-updates'])],
  ['runtimeVersion', Boolean(app.runtimeVersion)],
  ['updates.url', Boolean(app.updates?.url)],
  ['extra.eas.projectId', Boolean(app.extra?.eas?.projectId)],
  ['preview channel', eas.build?.preview?.channel === 'preview'],
  ['production channel', eas.build?.production?.channel === 'production'],
];

let failed = false;
for (const [name, ok] of checks) {
  console.log(`${ok ? 'OK ' : 'ERR'}  ${name}`);
  failed ||= !ok;
}

if (failed) {
  console.error('\nEAS is not fully configured yet. Run: npm run eas:bootstrap');
  process.exit(1);
}

console.log('\nEAS project configuration is ready.');
NODE
