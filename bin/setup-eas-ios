#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO="${RECHIBOX_GITHUB_REPO:-sergii/rechibox}"

cd "$ROOT_DIR"

section() {
  echo
  echo "==> $1"
}

confirm() {
  local prompt="$1"
  local answer
  read -r -p "$prompt [Y/n] " answer
  case "${answer:-Y}" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) return 1 ;;
  esac
}

for command_name in git node npm; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name"
    exit 1
  fi
done

INITIAL_DIRTY="$(git status --porcelain)"

section "1/7 Install dependencies and validate the current project"
npm ci
npm run typecheck
npm run lint

section "2/7 Sign in to Expo and configure the EAS project"
echo "Preparing EAS CLI. The first run can take a moment while npm downloads it."
bash ./bin/bootstrap-eas

section "3/7 Configure the GitHub Actions Expo token"
if ! command -v gh >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1 && confirm "GitHub CLI is missing. Install it with Homebrew now?"; then
    brew install gh
  else
    echo "GitHub CLI (gh) is required to configure EXPO_TOKEN automatically."
    echo "Install gh and rerun this command."
    exit 1
  fi
fi

if ! gh auth status >/dev/null 2>&1; then
  echo "GitHub CLI is not authenticated. Starting GitHub login..."
  gh auth login
fi

if gh secret list --repo "$REPO" 2>/dev/null | awk '{print $1}' | grep -qx 'EXPO_TOKEN'; then
  echo "EXPO_TOKEN is already configured in GitHub Actions."
else
  bash ./bin/configure-expo-token
fi

section "4/7 Verify EAS configuration"
npm run eas:check
npx --yes eas-cli@latest project:status

section "5/7 Commit and push generated EAS configuration"
if [ -z "$INITIAL_DIRTY" ]; then
  git add -A

  if git diff --cached --quiet; then
    echo "No generated configuration changes need to be committed."
  else
    git commit -m "Configure Expo EAS deployment"
    git push
  fi
else
  echo "The working tree was already dirty when setup started."
  echo "To avoid mixing unrelated work, setup will not commit or push automatically."
  echo "Review and commit the EAS-generated changes before relying on GitHub automation."
  git status --short
fi

section "6/7 Register an iPhone for internal distribution"
echo "An iOS preview build uses ad hoc signing, so the test iPhone must be registered."
echo "Expo may open a registration URL or show a QR code. Complete the flow on the iPhone."
if confirm "Register an iPhone now?"; then
  npx --yes eas-cli@latest device:create
else
  echo "Skipping device registration. You can run npm run eas:device:ios later."
fi

section "7/7 Create the first iOS preview cloud build"
echo "The first build can ask for Apple Developer login, 2FA, certificates, and provisioning."
if confirm "Start the first iOS preview build now?"; then
  npx --yes eas-cli@latest build --platform ios --profile preview
else
  echo "Skipping the first build. You can run npm run eas:build:preview:ios later."
fi

echo
echo "EAS setup flow finished."
echo "After the preview build is installed, normal JavaScript/UI changes can flow through GitHub CI -> EAS Update -> the preview channel."
