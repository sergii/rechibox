#!/usr/bin/env bash
set -euo pipefail

CHECK_ONLY=0
if [[ "${1:-}" == "--check" ]]; then
  CHECK_ONLY=1
  shift
fi

TARGET="${1:-auto}"
CONNECTION="${EXPO_CONNECTION:-lan}"

case "$TARGET" in
  auto|ios|android) ;;
  *)
    echo "Usage: $0 [--check] [auto|ios|android]" >&2
    exit 2
    ;;
esac

case "$CONNECTION" in
  lan|tunnel) ;;
  *)
    echo "EXPO_CONNECTION must be 'lan' or 'tunnel'." >&2
    exit 2
    ;;
esac

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

EXPECTED_NODE="$(tr -d 'v[:space:]' < .nvmrc)"
EXPECTED_NPM="$(sed -n 's/.*"packageManager": "npm@\([^"]*\)".*/\1/p' package.json)"
ACTUAL_NODE="$(node -v 2>/dev/null | sed 's/^v//' || true)"
ACTUAL_NPM="$(npm -v 2>/dev/null || true)"

echo "Rechibox real-device helper"
echo "Toolchain: Node ${ACTUAL_NODE:-missing} (expected $EXPECTED_NODE), npm ${ACTUAL_NPM:-missing} (expected $EXPECTED_NPM)"

if [[ "$CHECK_ONLY" -eq 0 ]] && { [[ "$ACTUAL_NODE" != "$EXPECTED_NODE" ]] || [[ "$ACTUAL_NPM" != "$EXPECTED_NPM" ]]; }; then
  echo "Refusing to start with a non-pinned toolchain. Activate Node $EXPECTED_NODE / npm $EXPECTED_NPM and retry." >&2
  exit 1
fi

IOS_DEVICES=""
IOS_USB_EVIDENCE=0
if [[ "$(uname -s)" == "Darwin" ]]; then
  if command -v xcrun >/dev/null 2>&1; then
    IOS_RAW="$(xcrun xctrace list devices 2>/dev/null || true)"
    IOS_DEVICES="$(printf '%s\n' "$IOS_RAW" | awk '
      /^== Devices ==/ { in_devices = 1; next }
      /^== Simulators ==/ { in_devices = 0 }
      in_devices && /(iPhone|iPad)/ { print }
    ')"
  fi

  if command -v system_profiler >/dev/null 2>&1 && system_profiler SPUSBDataType 2>/dev/null | grep -Eq 'iPhone|iPad'; then
    IOS_USB_EVIDENCE=1
  fi
fi

ADB=""
if command -v adb >/dev/null 2>&1; then
  ADB="$(command -v adb)"
elif [[ -n "${ANDROID_HOME:-}" && -x "${ANDROID_HOME}/platform-tools/adb" ]]; then
  ADB="${ANDROID_HOME}/platform-tools/adb"
fi

ANDROID_DEVICES=""
ANDROID_UNAUTHORIZED=""
if [[ -n "$ADB" ]]; then
  ANDROID_RAW="$($ADB devices -l 2>/dev/null || true)"
  ANDROID_DEVICES="$(printf '%s\n' "$ANDROID_RAW" | awk 'NR > 1 && $2 == "device" { print }')"
  ANDROID_UNAUTHORIZED="$(printf '%s\n' "$ANDROID_RAW" | awk 'NR > 1 && $2 == "unauthorized" { print }')"
fi

echo
echo "iOS/iPadOS physical devices visible to Xcode:"
if [[ -n "$IOS_DEVICES" ]]; then
  printf '%s\n' "$IOS_DEVICES"
else
  echo "  none detected"
fi
if [[ "$IOS_USB_EVIDENCE" -eq 1 ]]; then
  echo "  USB evidence: iPhone/iPad is visible in macOS USB inventory"
else
  echo "  USB evidence: not confirmed (the device may still be paired wirelessly)"
fi

echo
echo "Android physical devices visible to adb:"
if [[ -n "$ANDROID_DEVICES" ]]; then
  printf '%s\n' "$ANDROID_DEVICES"
else
  echo "  none detected"
fi
if [[ -n "$ANDROID_UNAUTHORIZED" ]]; then
  echo "  unauthorized devices:"
  printf '%s\n' "$ANDROID_UNAUTHORIZED"
  echo "  Unlock the phone and accept the USB debugging prompt."
fi

if [[ "$CHECK_ONLY" -eq 1 ]]; then
  exit 0
fi

if [[ "$TARGET" == "auto" ]]; then
  if [[ -n "$IOS_DEVICES" && -n "$ANDROID_DEVICES" ]]; then
    echo >&2
    echo "Both iOS and Android physical devices are visible. Use 'npm run iphone' or 'npm run device:android'." >&2
    exit 2
  elif [[ -n "$IOS_DEVICES" ]]; then
    TARGET="ios"
  elif [[ -n "$ANDROID_DEVICES" ]]; then
    TARGET="android"
  else
    TARGET="generic"
  fi
fi

echo
case "$TARGET" in
  ios)
    echo "Starting Expo Go server for a physical iPhone/iPad over $CONNECTION."
    echo "Cable detection is diagnostic only: Expo Go opens this project from the QR code over the network."
    echo "On iPhone/iPad, scan the QR code with the system Camera app."
    ;;
  android)
    echo "Starting Expo Go server for a physical Android device over $CONNECTION."
    echo "Open Expo Go on the phone and scan the QR code."
    ;;
  generic)
    echo "No physical device is visible to Xcode/adb. A cable is not required for Expo Go."
    echo "Starting a $CONNECTION QR anyway; keep the phone and Mac on the same network when using LAN."
    ;;
esac

if [[ "$CONNECTION" == "tunnel" ]]; then
  echo "Tunnel mode is slower but works across networks that block LAN discovery."
fi

echo
exec npx expo start "--$CONNECTION"
